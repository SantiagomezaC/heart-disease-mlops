adas a las mismas versiones con que se entrenó el modelo.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"mnoAWMGOU1"}],"key":"AH2ysyZQNP"}],"key":"fg746mmE18"}],"key":"uaEKWdtYzh"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"next":{"title":"Parte I. Análisis exploratorio, preprocesamiento y detección de fuga de datos","url":"/model-leakage-demo","group":"Predicción de falla cardíaca con pipelines de aprendizaje automático"}}},"domain":"http://localhost:3000"}