,{"type":"text","value":" del propio flujo. ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"XvfvCHGgnZ"},{"type":"inlineCode","value":"kubernetes","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"ZCstpqIazi"},{"type":"text","value":" crea un clúster con kind, carga la imagen recién construida, aplica los manifiestos de ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"YGu4lx3VLH"},{"type":"inlineCode","value":"k8s/","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"b1pEAwWuQr"},{"type":"text","value":", espera el ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"vUOTbzuvgR"},{"type":"emphasis","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"rollout","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"e6gGP3LQJf"}],"key":"oBkFm6Bn2e"},{"type":"text","value":" y consulta el ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"gJ4SlSJFMf"},{"type":"inlineCode","value":"Service","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"NgaOnEuKTW"},{"type":"text","value":". ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"UPdwxPZgny"},{"type":"inlineCode","value":"drift","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"peqkJfyxu1"},{"type":"text","value":", que corre en paralelo, ejecuta ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"waFonLpzuJ"},{"type":"inlineCode","value":"monitoring/drift_report.py","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"HNePeTMt08"},{"type":"text","value":" y publica los reportes HTML como artefactos descargables.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"sT2o7fshlk"}],"key":"bAKVRGqp4m"},{"type":"mermaid","value":"flowchart LR\n  P[push / pull request] --> B[build<br/>flake8 + pytest]\n  B --> D[docker<br/>build + prueba de humo<br/>+ push a GHCR]\n  D --> K[kubernetes<br/>kind + kubectl apply<br/>+ prueba del Service]\n  B --> M[drift<br/>reportes de Evidently]","key":"zqUVEWPLfY"},{"type":"include","file":"../.github/workflows/ci.yml","literal":true,"caption":[{"type":"text","value":".github/workflows/ci.yml","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"lc8IeLyrmp"}],"children":[{"type":"container","kind":"code","children":[{"type":"code","value":"name: CI\n\non: [push, pull_request, workflow_dispatch]\n\nenv:\n  IMAGE: ghcr.io/santiagomezac/heart-api\n\njobs:\n  # Etapa 5 — linting y pruebas automáticas en cada push\n  build:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v7\n      - name: Set up Python\n        uses: actions/setup-python@v7\n        with:\n          python-version: '3.10'\n          cache: pip\n          cache-dependency-path: docker/requirements.txt\n      - name: Install dependencies\n        run: |\n          pip install -r docker/requirements.txt\n          pip install flake8 pytest httpx\n      - name: Lint\n        run: flake8 app/ tests/\n      - name: Tests\n        run: pytest tests/ -v\n\n  # Etapa 3 en CI — construcción de la imagen y prueba de humo del contenedor\n  docker:\n    needs: build\n    runs-on: ubuntu-latest\n    permissions:\n      contents: read\n      packages: write\n    steps:\n      - uses: actions/checkout@v7\n      - name: Build image\n        run: docker build -t heart-api -f docker/Dockerfile .\n      - name: Smoke test\n        run: |\n          docker run -d --name heart -p 8000:8000 heart-api\n          for i in $(seq 1 30); do curl -sf localhost:8000/health && break; sleep 1; done\n          curl -sf -X POST localhost:8000/predict \\\n            -H \"Content-Type: application/json\" \\\n            -d '{\"features\":[54,\"M\",\"ASY\",140,239,0,\"Normal\",160,\"N\",1.2,\"Flat\"]}' | tee response.json\n          python3 -c \"import json; r = json.load(open('response.json')); assert 0 <= r['heart_disease_probability'] <= 1\"\n          docker rm -f heart\n      - name: Save image\n        run: |\n          docker tag heart-api ${{ env.IMAGE }}:latest\n          docker save ${{ env.IMAGE }}:latest -o heart-api.tar\n      - uses: actions/upload-artifact@v7\n        with:\n          name: heart-api-image\n          path: heart-api.tar\n          retention-days: 3\n      - name: Push to GHCR\n        if: github.ref == 'refs/heads/main' && github.event_name != 'pull_request'\n        run: |\n          echo \"${{ secrets.GITHUB_TOKEN }}\" | docker login ghcr.io -u ${{ github.actor }} --password-stdin\n          docker tag heart-api ${{ env.IMAGE }}:${{ github.sha }}\n          docker push ${{ env.IMAGE }}:latest\n          docker push ${{ env.IMAGE }}:${{ github.sha }}\n\n  # Etapa 4 en CI — despliegue de los manifiestos en un clúster efímero (kind)\n  kubernetes:\n    needs: docker\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v7\n      - uses: actions/download-artifact@v8\n        with:\n          name: heart-api-image\n      - name: Create kind cluster\n        uses: helm/kind-action@v1\n        with:\n          cluster_name: heart\n      - name: Load image and deploy\n        run: |\n          kind load image-archive heart-api.tar --name heart\n          kubectl apply -f k8s/deployment.yaml\n          kubectl apply -f k8s/service.yaml\n          kubectl rollout status deployment/heart-model --timeout=180s\n          kubectl get pods,svc -o wide\n      - name: Test service\n        run: |\n          kubectl port-forward svc/heart-service 8080:80 &\n          for i in $(seq 1 30); do curl -sf localhost:8080/health && break; sleep 1; done\n          curl -sf -X POST localhost:8080/predict \\\n            -H \"Content-Type: application/json\" \\\n            -d '{\"features\":[65,\"M\",\"ASY\",150,0,1,\"ST\",100,\"Y\",2.5,\"Flat\"]}'\n\n  # Etapa 6 en CI — reporte de deriva de datos con Evidently\n  drift:\n    needs: build\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v7\n      - uses: actions/setup-python@v7\n        with:\n          python-version: '3.10'\n      - name: Install monitoring dependencies\n        run: pip install -r monitoring/requirements.txt\n      - name: Generate drift reports\n        run: python monitoring/drift_report.py\n      - uses: actions/upload-artifact@v7\n        with:\n          name: drift-reports\n          path: |\n            drift_report.html\n            reports/drift_report_simulated.html\n            reports/drift_summary.json\n","lang":"yaml","filename":"ci.yml","key":"K7ney8kwj2"},{"type":"caption","children":[{"type":"paragraph","children":[{"type":"text","value":".github/workflows/ci.yml","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"lc8IeLyrmp"}],"key":"Mvy3tq4CHJ"}],"key":"ynqggCWEGM"}],"enumerator":"1","key":"jJE51HlrAb"}],"key":"bYQTZgjwCy"},{"type":"heading","depth":2,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"2. Pruebas automáticas","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"K4eNUQNYmM"}],"identifier":"id-2-pruebas-autom-ticas","label":"2. Pruebas automáticas","html_id":"id-2-pruebas-autom-ticas","implicit":true,"key":"r7APpmp5ss"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Las 16 pruebas cubren dos dimensiones. ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"evGeKc9n9s"},{"type":"inlineCode","value":"tests/test_api.py","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"KhBnzLvgY8"},{"type":"text","value":" verifica el contrato del servicio: la sonda de salud, el formato 